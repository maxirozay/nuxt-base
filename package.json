{
  "name": "nuxt-base",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "deploy": "./scripts/deploy.sh",
    "postinstall": "nuxt prepare",
    "db:seed": "npx jiti ./server/database/seed.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:push-remote": "REMOTE_PUSH=true drizzle-kit push",
    "db:migrate": "npx jiti ./server/database/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1092.0",
    "@aws-sdk/s3-request-presigner": "^3.1092.0",
    "@nuxt/hints": "1.1.4",
    "@nuxt/icon": "2.3.1",
    "@pinia/nuxt": "1.0.1",
    "@simplewebauthn/browser": "^13.3.0",
    "@simplewebauthn/server": "^13.3.2",
    "drizzle-orm": "1.0.0-rc.3",
    "goku-css": "^9.0.4",
    "nodemailer": "^9.0.3",
    "nuxt": "^4.5.1",
    "nuxt-auth-utils": "0.5.29",
    "nuxt-i18n-micro": "^3.21.4",
    "otplib": "^13.4.1",
    "pg": "^8.22.0",
    "pinia": "^4.0.2",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "1.0.0-rc.3",
    "drizzle-seed": "^0.3.1",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0"
  }
}
